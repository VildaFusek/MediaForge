<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MediaForge.Views.ConversionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaForge.Controls">
    <Grid x:Name="Surface" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <controls:RepoIcon Data="{StaticResource RepoVideo}" Width="30" Height="30"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Převést videa" Style="{ThemeResource TitleTextBlockStyle}"/>
            </StackPanel>
            <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="1. Vyberte videa" FontWeight="SemiBold"/>
                    <Button Click="AddFiles_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Přidat videa">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:RepoIcon Data="{StaticResource RepoFolderAdd}"/>
                            <TextBlock Text="Přidat videa…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Rovnou se zařadí do fronty. Lze vybrat více souborů najednou."
                               TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="2. Pro jaké zařízení?" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              IsEnabled="{Binding CanEditSettings}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Cílové zařízení"/>
                    <TextBlock Text="{Binding ProfileDescription}" TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                    <ComboBox Header="HDR" ItemsSource="{Binding HdrOptions}" SelectedItem="{Binding SelectedHdr, Mode=TwoWay}"
                              IsEnabled="{Binding CanEditSettings}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding SettingsScopeDescription}" TextWrapping="Wrap" FontSize="12" MaxLines="2"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="3. Spusťte převod" FontWeight="SemiBold"/>
                    <Button x:Name="StartConversionButton" Command="{Binding StartCommand}" HorizontalAlignment="Stretch"
                            Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Spustit převod">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:RepoIcon Data="{StaticResource RepoPlay}" Foreground="{Binding Foreground, ElementName=StartConversionButton}"/>
                            <TextBlock Text="Spustit převod" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Originály zůstanou. Výchozí cíl: vedle zdroje; zvuk podle jazyka Windows."
                               TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Padding="0,0,12,12">
                <InfoBar IsOpen="{Binding HasSettingsError}" IsClosable="False" Severity="Warning"
                         Title="Upravte nastavení" Message="{Binding SettingsError}"/>
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding QueueSummary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="Monitor běžícího převodu" Click="Monitor_Click" IsEnabled="{Binding IsRunning}"/>
                    </Grid>
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarButton Icon="Pause" Label="Zastavit po aktuálním" Command="{Binding StopAfterCurrentCommand}"/>
                        <AppBarButton Icon="Cancel" Label="Zrušit aktuální a zastavit" Command="{Binding CancelCommand}"/>
                        <AppBarSeparator/>
                        <AppBarButton Icon="Delete" Label="Odebrat vybrané" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedJob}"/>
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Icon="Clear" Label="Odebrat všechna čekající videa" Command="{Binding ClearWaitingCommand}"/>
                            <AppBarButton Icon="Refresh" Label="Zopakovat vybrané jako novou úlohu"
                                          Command="{Binding RetryCommand}" CommandParameter="{Binding SelectedJob}"/>
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <ListView x:Name="JobsList" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                              SelectionMode="Single" SelectionChanged="Jobs_SelectionChanged" Height="240"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Padding="4,6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding InputPath}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Description}" Opacity="0.75"/>
                                    <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}"/>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxLines="2" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <Expander Header="Chci pro jednotlivá videa jiné nastavení" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <CheckBox Content="Měnit nastavení pouze vybraného čekajícího videa"
                                  IsChecked="{Binding EditSelectedOnly, Mode=TwoWay}"/>
                        <TextBlock Text="Bez zaškrtnutí se změna profilu a pokročilých voleb použije na všechna čekající videa. Běžící ani dokončené úlohy se nemění. Zvukové a video stopy se vždy upravují jen u vybraného videa."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Chci jiný jazyk nebo jinou stopu vybraného videa" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding SelectedJob.Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AudioSelectionHint}" TextWrapping="Wrap"/>
                        <ComboBox Header="Zvuk a jazyk" ItemsSource="{Binding SelectedInput.AudioTracks}"
                                  SelectedItem="{Binding SelectedInput.SelectedAudio, Mode=OneWay}"
                                  SelectionChanged="AudioTrack_SelectionChanged" IsEnabled="{Binding CanEditSelected}"
                                  HorizontalAlignment="Stretch"/>
                        <ComboBox Header="Video stopa" ItemsSource="{Binding SelectedInput.VideoTracks}"
                                  SelectedItem="{Binding SelectedInput.SelectedVideo, Mode=OneWay}"
                                  SelectionChanged="VideoTrack_SelectionChanged" IsEnabled="{Binding CanEditSelected}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding SelectedInput.TrackStatus}" TextWrapping="Wrap"/>
                        <Button Content="Znovu načíst stopy" Click="ReloadTracks_Click" IsEnabled="{Binding CanEditSelected}"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Chci změnit složku nebo názvy výstupů" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <ContentControl IsEnabled="{Binding CanEditSettings}" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <CheckBox Content="Ukládat ke zdroji (každé video do své složky)" IsChecked="{Binding UseSourceDirectory, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}"/>
                        <TextBox Header="Cílová složka / náhled složky vybraného videa" IsEnabled="{Binding UseCustomDirectory}"
                                 Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Vybrat jinou složku…" Click="OutputFolder_Click" IsEnabled="{Binding CanEditSettings}"/>
                        <TextBlock Text="Původní název s příponou .mp4; při kolizi automaticky chytrý název."
                                   TextWrapping="Wrap"/>
                        <Button Content="Náhled chytrého názvu…" Click="PreviewSmartName_Click" IsEnabled="{Binding CanEditSelected}"/>
                        <TextBlock Text="Existující soubory se nepřepisují. Titul se přebírá z metadat, jinak z původního názvu."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                    </ContentControl>
                </Expander>

                <Expander Header="Pokročilé: ruční kvalita a GPU" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <CheckBox Content="Ruční nastavení místo profilu zařízení" IsChecked="{Binding IsManual, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}"/>
                        <ContentControl IsEnabled="{Binding CanEditSettings}" HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ComboBox Header="Kodek" ItemsSource="{Binding Codecs}" SelectedItem="{Binding ManualCodec, Mode=TwoWay}"
                                          IsEnabled="{Binding IsManual}" HorizontalAlignment="Stretch"/>
                                <NumberBox Grid.Column="1" Header="Nejvýše fps" Value="{Binding FrameRate, Mode=TwoWay}" Minimum="1" Maximum="120" IsEnabled="{Binding IsManual}"/>
                                <NumberBox Grid.Row="1" Header="Max. šířka" Value="{Binding Width, Mode=TwoWay}" Minimum="128" Maximum="7680" IsEnabled="{Binding IsManual}"/>
                                <NumberBox Grid.Row="1" Grid.Column="1" Header="Max. výška" Value="{Binding Height, Mode=TwoWay}" Minimum="128" Maximum="4320" IsEnabled="{Binding IsManual}"/>
                                <NumberBox Grid.Row="2" Header="Video kb/s" Value="{Binding VideoKbps, Mode=TwoWay}" Minimum="250" Maximum="100000" IsEnabled="{Binding IsManual}"/>
                                <NumberBox Grid.Row="2" Grid.Column="1" Header="AAC kb/s" Value="{Binding AudioKbps, Mode=TwoWay}" Minimum="64" Maximum="512" IsEnabled="{Binding IsManual}"/>
                            </Grid>
                        </ContentControl>
                        <ComboBox Header="Dekódování" ItemsSource="{Binding Decoders}" SelectedItem="{Binding SelectedDecoder, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}" HorizontalAlignment="Stretch"/>
                        <ComboBox Header="Enkódování" ItemsSource="{Binding Encoders}" SelectedItem="{Binding SelectedEncoder, Mode=OneWay}"
                                  SelectionChanged="Encoder_SelectionChanged"
                                  IsEnabled="{Binding CanEditSettings}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Automatický enkodér preferuje ověřenou GPU. CPU dekódování je výchozí; GPU dekodér se ověří na konkrétním vstupu. Filtry zůstávají na CPU a GPU cesta se při chybě skrytě nepřepíná."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock Text="Výstup: MP4, jedna video a jedna zvuková stopa (AAC stereo), bez titulků. HDR → SDR používá tone mapping do BT.709. Zachování HDR10/HLG vyžaduje HEVC profil a automatický nebo CPU libx265 enkodér; HDR výstup má 10 bitů. SDR vstup se na HDR nemění. Dolby Vision ani zachování HDR10+ nejsou podporované. Rozlišení se nezvětšuje; kompatibilita konkrétního zařízení není zaručena."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBlock Text="HDR metadata se kontrolují v hlavičce a úvodních 64 video paketech; případné pozdější dynamické změny se neověřují. HDR → SDR vyžaduje FFmpeg s filtry zscale a tonemap."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                        <Expander Header="Vybavení počítače a ověření enkodérů" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <Button Content="Znovu zjistit hardware" Command="{Binding DetectCommand}"/>
                                <TextBlock Text="{Binding HardwareSummary}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <TextBox Text="{Binding HardwareLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

                <Expander Header="Podrobnosti a protokol vybraného videa" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding SelectedJob.Description}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="{Binding SelectedJob.Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBox Header="Výstup" Text="{Binding SelectedJob.OutputPath, Mode=OneWay}" IsReadOnly="True"/>
                        <TextBox Header="Úplný protokol" Text="{Binding SelectedJob.LogPath, Mode=OneWay}" IsReadOnly="True"/>
                        <Button Content="Otevřít úplný protokol" Click="OpenLog_Click"/>
                        <TextBox Header="Poslední zprávy" Text="{Binding SelectedJob.LogTail, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="220" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Fronta se po restartu neobnovuje; protokoly zůstávají na disku." Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" MaxLines="3" IsTextSelectionEnabled="True"/>
    </Grid>
</UserControl>
