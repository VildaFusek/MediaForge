<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaForge.Views.ConversionMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MediaForge – monitor převodů">
    <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
    <Grid x:Name="Surface" Padding="24" RowSpacing="16" Background="{ThemeResource BrandShellBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="Monitor převodů" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="{Binding QueueSummary}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CurrentTask}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
            <ProgressBar Value="{Binding CurrentPercent}" IsIndeterminate="{Binding CurrentIndeterminate}"/>
            <TextBlock Text="{Binding CurrentDetail}" TextWrapping="Wrap" MaxLines="5" IsTextSelectionEnabled="True"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="24" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Name="CpuText" Text="CPU: nezjištěno"/>
                <ProgressBar x:Name="CpuBar" Maximum="100"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock x:Name="MemoryText" Text="RAM: nezjištěno"/>
                <ProgressBar x:Name="MemoryBar" Maximum="100"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock x:Name="EncodeText" Text="GPU encode: nezjištěno"/>
                <ProgressBar x:Name="EncodeBar" Maximum="100"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                <TextBlock x:Name="DecodeText" Text="GPU decode: nezjištěno"/>
                <ProgressBar x:Name="DecodeBar" Maximum="100"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="CPU a RAM: celý počítač. GPU: nejvytíženější encode/decode engine napříč adaptéry, včetně ostatních aplikací. Nedostupné čítače se nezobrazují jako nulová zátěž. Vzorkování přibližně 1× za sekundu."
                   TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Content="Ovládání a fronta" Click="Controls_Click"/>
            <Button Content="Zastavit po aktuální" Command="{Binding StopAfterCurrentCommand}"/>
            <Button Content="Zrušit aktuální a zastavit" Command="{Binding CancelCommand}"/>
        </StackPanel>
        <TextBox Grid.Row="4" Header="Protokol aktuální / poslední úlohy" Text="{Binding CurrentLogTail, Mode=OneWay}"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        <TextBlock Grid.Row="5" Text="Zavření monitoru nezastaví frontu. Ovládání a úplné protokoly jsou na kartě Převody v hlavním okně."
                   TextWrapping="Wrap" Opacity="0.7"/>
    </Grid>
</Window>
