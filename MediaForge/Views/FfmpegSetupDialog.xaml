<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MediaForge.Views.FfmpegSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Příprava FFmpeg, FFprobe a FFplay"
    CloseButtonText="Zavřít"
    Closing="Dialog_Closing"
    DefaultButton="Close">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MinWidth="420">
            <TextBlock Text="Stabilní Windows x64 • Gyan.dev Essentials • GPLv3" TextWrapping="Wrap"/>
            <TextBlock Text="Stažení se spustí až po vašem potvrzení. Ověření, rozbalení a aktivace pak proběhnou automaticky. Licence a dokumentace zůstanou součástí instalace."
                       TextWrapping="Wrap" FontSize="12" Opacity="0.75"/>
            <Grid ColumnSpacing="16" RowSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Místní verze"/>
                <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="Nejnovější stabilní"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersion}"/>
            </Grid>
            <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}"
                             IsIndeterminate="{Binding IsIndeterminate}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12"/>
            </Grid>
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
            <Button Content="Stáhnout a nainstalovat" Command="{Binding InstallCommand}"
                    Style="{StaticResource AccentButtonStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Zkontrolovat verzi" Command="{Binding CheckCommand}"/>
                <Button Content="Zrušit" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <TextBlock Text="Umístění nástrojů (složka musí být zapisovatelná)" FontSize="12"/>
            <TextBlock Text="{Binding RuntimeDirectory}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="Podrobný protokol" FontWeight="SemiBold"/>
            <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                     Height="220" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="Úplný instalační log se ukládá do podsložky logs. Předchozí instalace se automaticky nemaže. Kontrolní součet pochází ze stejného HTTPS zdroje jako balíček; nejde o nezávislý digitální podpis."
                       FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
