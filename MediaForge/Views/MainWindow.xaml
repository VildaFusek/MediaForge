<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MediaForge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MediaForge"
    xmlns:views="using:MediaForge.Views"
    xmlns:controls="using:MediaForge.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MediaForge"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ShellRoot" Background="{ThemeResource BrandShellBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" AutomationProperties.Name="MediaForge">
            <TitleBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image Source="ms-appx:///Assets/MediaForgeMark.svg" Width="36" Height="36"
                           AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                               AutomationProperties.Name="MediaForge">
                        <Run Text="Media" Foreground="{ThemeResource BrandTextBrush}"/><Run Text="Forge" Foreground="{ThemeResource BrandForgeBrush}"/>
                    </TextBlock>
                    <Button Background="Transparent" BorderThickness="0" AutomationProperties.Name="Motiv aplikace"
                            ToolTipService.ToolTip="Motiv aplikace" VerticalAlignment="Center">
                        <controls:RepoIcon Data="{StaticResource RepoSliders}"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <RadioMenuFlyoutItem Text="Podle systému" Tag="Default" IsChecked="True" GroupName="Theme" Click="Theme_Click"/>
                                <RadioMenuFlyoutItem Text="Světlý motiv" Tag="Light" GroupName="Theme" Click="Theme_Click"/>
                                <RadioMenuFlyoutItem Text="Tmavý motiv" Tag="Dark" GroupName="Theme" Click="Theme_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.Content>
        </TitleBar>

        <TabView x:Name="WorkspaceTabs" Grid.Row="1" IsAddTabButtonVisible="False"
                 CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent">
            <TabViewItem IsClosable="False" AutomationProperties.Name="Soubory">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:RepoIcon Data="{StaticResource RepoFolder}"/><TextBlock Text="Soubory" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabViewItem.Header>
                <Frame x:Name="RootFrame"/>
            </TabViewItem>
            <TabViewItem x:Name="ConversionTab" IsClosable="False" AutomationProperties.Name="Převody">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:RepoIcon Data="{StaticResource RepoVideo}"/><TextBlock Text="Převody" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabViewItem.Header>
                <views:ConversionPanel/>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
