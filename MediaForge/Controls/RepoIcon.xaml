<UserControl
    x:Class="MediaForge.Controls.RepoIcon"
    x:Name="IconRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="20" Height="20" IsTabStop="False" IsHitTestVisible="False"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    AutomationProperties.AccessibilityView="Raw">
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path x:Name="IconPath" Stroke="{Binding Foreground, ElementName=IconRoot}"
                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Canvas>
    </Viewbox>
</UserControl>
