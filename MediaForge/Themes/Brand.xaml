<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#FF6A00</Color>
            <Color x:Key="SystemAccentColorLight1">#FF852E</Color>
            <Color x:Key="SystemAccentColorLight2">#FFA65C</Color>
            <Color x:Key="SystemAccentColorLight3">#FFD6B5</Color>
            <Color x:Key="SystemAccentColorDark1">#C94B00</Color>
            <Color x:Key="SystemAccentColorDark2">#A83B00</Color>
            <Color x:Key="SystemAccentColorDark3">#7A2B00</Color>
            <SolidColorBrush x:Key="BrandShellBrush" Color="#E6F3F4F6"/>
            <SolidColorBrush x:Key="BrandTextBrush" Color="#242830"/>
            <SolidColorBrush x:Key="BrandForgeBrush" Color="#B84000"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF6A00"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F0FF6A00"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D9FF6A00"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#B84000"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#A83B00"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#943400"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1C2027"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E61C2027"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FF60646C"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FF6A00</Color>
            <Color x:Key="SystemAccentColorLight1">#FF852E</Color>
            <Color x:Key="SystemAccentColorLight2">#FFA65C</Color>
            <Color x:Key="SystemAccentColorLight3">#FFD6B5</Color>
            <Color x:Key="SystemAccentColorDark1">#C94B00</Color>
            <Color x:Key="SystemAccentColorDark2">#A83B00</Color>
            <Color x:Key="SystemAccentColorDark3">#7A2B00</Color>
            <SolidColorBrush x:Key="BrandShellBrush" Color="#E620242B"/>
            <SolidColorBrush x:Key="BrandTextBrush" Color="#F4F5F7"/>
            <SolidColorBrush x:Key="BrandForgeBrush" Color="#FF9A45"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF852E"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F0FF852E"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D9FF852E"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFA65C"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF9A45"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF852E"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1C2027"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E61C2027"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FF92969D"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BrandShellBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BrandTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BrandForgeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
